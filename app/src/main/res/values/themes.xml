<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GestionPecuaria" parent="android:Theme.Material.Light.NoActionBar">
        <!-- La aplicación nunca debe iniciar en pantalla completa. -->
        <item name="android:windowFullscreen">false</item>
        <!-- La interfaz es clara, por eso los iconos de estado deben ser oscuros. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
    </style>
</resources>
